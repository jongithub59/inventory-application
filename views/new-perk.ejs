<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head.ejs') %>
    <div class="create-product content">
      <header class="content-header"><h2>Add Perk-a-Cola</h2></header>

      <div class="create-container container">
        <form action="/new" method="POST">
          <label for="name">Name:</label>
          <input type="text" id="name" name="nameField" required />
          <label for="cost">Cost:</label>
          <input type="text" id="cost" name="costField" required />
          <label for="color">Color:</label>
          <input type="text" id="color" name="colorField" required />
          <label for="quantity">Quantity:</label>
          <input type="number" id="quantity" name="quantityField" required />
          <button>Submit</button>
        </form>
      </div>
    </div>
  </body>
</html>
